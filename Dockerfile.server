FROM node:20-alpine AS runner
WORKDIR /app

# Install libc compatibility for Prisma engine binaries
RUN apk add --no-cache libc6-compat openssl wget

COPY package.json package-lock.json* ./
COPY prisma ./prisma/

# Install dependencies including Prisma and tsx runtime
RUN npm ci

COPY server ./server/
COPY lib ./lib/
COPY tsconfig.json ./

# Generate Prisma client for linux-musl
RUN npx prisma generate

ENV NODE_ENV=production
ENV PORT=1234
ENV HOST=0.0.0.0

EXPOSE 1234

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:1234/health || exit 1

CMD ["npx", "tsx", "server/index.ts"]
